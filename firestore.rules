rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerifiedOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTempleId(templeId) {
      return templeId is string && templeId.size() >= 2 && templeId.size() <= 48 && templeId.matches('^[a-z0-9_]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && (dateKey.size() == 0 || (dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    function isValidHexColor(hex) {
      return hex is string && hex.size() == 7 && hex.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidStringList(val, maxItems) {
      return val is list && val.size() <= maxItems;
    }

    function isValidPilgrimProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'activeTempleId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'characterModelKey',
          'nationalityId',
          'elderFontScale',
          'readAlongRate',
          'activeTempleId',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && isValidTempleId(data.activeTempleId)
        && (!('characterModelKey' in data) || (data.characterModelKey is string && data.characterModelKey.size() <= 40))
        && (!('nationalityId' in data) || (data.nationalityId is string && data.nationalityId.size() <= 32))
        && (!('elderFontScale' in data) || (data.elderFontScale is number && data.elderFontScale >= 0.85 && data.elderFontScale <= 1.5))
        && (!('readAlongRate' in data) || (data.readAlongRate is number && data.readAlongRate >= 0.6 && data.readAlongRate <= 1.4))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTempleProgress(data, uid, templeId) {
      return data.keys().hasAll([
          'ownerUid',
          'templeId',
          'visitedStations',
          'heritageStamps',
          'arhatStamps',
          'practicedDays',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'templeId',
          'visitedStations',
          'heritageStamps',
          'arhatStamps',
          'practicedDays',
          'dailyOracleDateKey',
          'dailyOracleId',
          'gardenStateJson',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid == uid
        && data.templeId == templeId
        && isValidTempleId(data.templeId)
        && isValidStringList(data.visitedStations, 40)
        && isValidStringList(data.heritageStamps, 30)
        && isValidStringList(data.arhatStamps, 30)
        && isValidStringList(data.practicedDays, 400)
        && (!('dailyOracleDateKey' in data) || isValidDateKey(data.dailyOracleDateKey))
        && (!('dailyOracleId' in data) || (data.dailyOracleId is string && data.dailyOracleId.size() <= 48))
        && (!('gardenStateJson' in data) || (data.gardenStateJson is string && data.gardenStateJson.size() <= 8192))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJournalEntry(data, uid) {
      return data.keys().hasAll(['ownerUid', 'templeId', 'text', 'mood', 'dateKey', 'createdAt'])
        && data.keys().hasOnly([
          'ownerUid',
          'templeId',
          'text',
          'mood',
          'moodLabel',
          'stationLabel',
          'dateKey',
          'createdAt'
        ])
        && data.ownerUid == uid
        && isValidTempleId(data.templeId)
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 600
        && data.mood is string && data.mood.size() >= 1 && data.mood.size() <= 32
        && (!('moodLabel' in data) || (data.moodLabel is string && data.moodLabel.size() <= 48))
        && (!('stationLabel' in data) || (data.stationLabel is string && data.stationLabel.size() <= 80))
        && isValidDateKey(data.dateKey)
        && data.createdAt is timestamp;
    }

    function isValidCommunityLanternCreate(data) {
      return data.keys().hasAll([
          'templeId',
          'authorUid',
          'authorName',
          'wishText',
          'colorHex',
          'pondX',
          'pondZ',
          'blessCount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'templeId',
          'authorUid',
          'authorName',
          'nationalityId',
          'wishText',
          'colorHex',
          'pondX',
          'pondZ',
          'blessCount',
          'createdAt',
          'updatedAt'
        ])
        && isValidTempleId(data.templeId)
        && data.authorUid == request.auth.uid
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && (!('nationalityId' in data) || (data.nationalityId is string && data.nationalityId.size() <= 32))
        && data.wishText is string && data.wishText.size() >= 1 && data.wishText.size() <= 240
        && isValidHexColor(data.colorHex)
        && data.pondX is number && data.pondX >= -25 && data.pondX <= 25
        && data.pondZ is number && data.pondZ >= -25 && data.pondZ <= 25
        && data.blessCount is int && data.blessCount == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidBlessingTowerEntryCreate(data) {
      return data.keys().hasAll([
          'templeId',
          'authorUid',
          'devoteeName',
          'categoryId',
          'wishText',
          'slotNumber',
          'tier',
          'dateKey',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'templeId',
          'authorUid',
          'devoteeName',
          'birthYear',
          'familyNote',
          'categoryId',
          'wishText',
          'slotNumber',
          'tier',
          'dateKey',
          'createdAt'
        ])
        && isValidTempleId(data.templeId)
        && data.authorUid == request.auth.uid
        && data.devoteeName is string && data.devoteeName.size() >= 1 && data.devoteeName.size() <= 80
        && (!('birthYear' in data) || (data.birthYear is string && data.birthYear.size() <= 8))
        && (!('familyNote' in data) || (data.familyNote is string && data.familyNote.size() <= 120))
        && data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 32
        && data.wishText is string && data.wishText.size() >= 1 && data.wishText.size() <= 260
        && data.slotNumber is int && data.slotNumber >= 1 && data.slotNumber <= 108
        && data.tier is int && data.tier >= 1 && data.tier <= 13
        && isValidDateKey(data.dateKey)
        && data.createdAt == request.time;
    }

    function isValidPublicProfile(data, uid) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'friendCode',
          'charKey',
          'merit',
          'streakDays',
          'giftsSent',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'friendCode',
          'charKey',
          'merit',
          'streakDays',
          'giftsSent',
          'currentArea',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && data.friendCode is string && data.friendCode.size() >= 4 && data.friendCode.size() <= 16
        && data.charKey is string && data.charKey.size() >= 1 && data.charKey.size() <= 32
        && data.merit is int && data.merit >= 0 && data.merit <= 1000000
        && data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 3650
        && data.giftsSent is int && data.giftsSent >= 0 && data.giftsSent <= 10000
        && (!('currentArea' in data) || (data.currentArea is string && data.currentArea.size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGiftTransactionCreate(data) {
      return data.keys().hasAll([
          'fromUid',
          'fromName',
          'toId',
          'toName',
          'giftId',
          'giftName',
          'message',
          'lotusCost',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'fromUid',
          'fromName',
          'toId',
          'toName',
          'giftId',
          'giftName',
          'message',
          'lotusCost',
          'createdAt'
        ])
        && data.fromUid == request.auth.uid
        && data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 64
        && data.toId is string && data.toId.size() >= 1 && data.toId.size() <= 128
        && data.toName is string && data.toName.size() >= 1 && data.toName.size() <= 64
        && data.giftId is string && data.giftId.size() >= 1 && data.giftId.size() <= 48
        && data.giftName is string && data.giftName.size() >= 1 && data.giftName.size() <= 80
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 240
        && data.lotusCost is int && data.lotusCost >= 0 && data.lotusCost <= 5000
        && data.createdAt == request.time;
    }

    function isValidCommunityPostCreate(data) {
      return data.keys().hasAll([
          'templeId',
          'authorUid',
          'authorName',
          'text',
          'rejoiceCount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'templeId',
          'authorUid',
          'authorName',
          'charKey',
          'area',
          'text',
          'rejoiceCount',
          'createdAt',
          'updatedAt'
        ])
        && isValidTempleId(data.templeId)
        && data.authorUid == request.auth.uid
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 64
        && (!('charKey' in data) || (data.charKey is string && data.charKey.size() <= 32))
        && (!('area' in data) || (data.area is string && data.area.size() <= 80))
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 240
        && data.rejoiceCount is int && data.rejoiceCount == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // ===============================================================
    // Collections
    // ===============================================================

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isVerifiedOwner(uid)
        && isValidId(uid)
        && isValidPilgrimProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isVerifiedOwner(uid)
        && isValidPilgrimProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isVerifiedOwner(uid);

      match /temples/{templeId} {
        allow get, list: if isOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && isValidTempleId(templeId)
          && isValidTempleProgress(request.resource.data, uid, templeId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isVerifiedOwner(uid)
          && isValidTempleProgress(request.resource.data, uid, templeId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.templeId == resource.data.templeId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isVerifiedOwner(uid);
      }

      match /journalEntries/{entryId} {
        allow get, list: if isOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && isValidId(entryId)
          && isValidJournalEntry(request.resource.data, uid)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedOwner(uid);
      }
    }

    match /templeLanterns/{lanternId} {
      allow get, list: if resource.data.templeId is string;
      allow create: if isVerified()
        && isValidId(lanternId)
        && isValidCommunityLanternCreate(request.resource.data);
      allow update: if isVerified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blessCount', 'updatedAt'])
        && request.resource.data.blessCount is int
        && resource.data.blessCount is int
        && request.resource.data.blessCount == resource.data.blessCount + 1
        && request.resource.data.blessCount <= 100000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isVerified() && resource.data.authorUid == request.auth.uid;
    }

    match /blessingTowerEntries/{entryId} {
      allow get, list: if resource.data.templeId is string;
      allow create: if isVerified()
        && isValidId(entryId)
        && isValidBlessingTowerEntryCreate(request.resource.data);
      allow update: if false;
      allow delete: if isVerified() && isValidId(entryId) && resource.data.authorUid == request.auth.uid;
    }

    match /publicProfiles/{uid} {
      allow get: if isValidId(uid) && resource.data.uid == uid;
      allow list: if resource.data.merit is int;
      allow create: if isVerifiedOwner(uid)
        && isValidId(uid)
        && isValidPublicProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isVerifiedOwner(uid)
        && isValidId(uid)
        && isValidPublicProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isVerifiedOwner(uid) && isValidId(uid);
    }

    match /giftTransactions/{giftId} {
      allow get: if isSignedIn()
        && isValidId(giftId)
        && (resource.data.fromUid == request.auth.uid || resource.data.toId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if isVerified()
        && isValidId(giftId)
        && isValidGiftTransactionCreate(request.resource.data);
      allow update: if false;
      allow delete: if isVerified() && isValidId(giftId) && resource.data.fromUid == request.auth.uid;
    }

    match /communityPosts/{postId} {
      allow get, list: if resource.data.templeId is string;
      allow create: if isVerified()
        && isValidId(postId)
        && isValidCommunityPostCreate(request.resource.data);
      allow update: if isVerified()
        && isValidId(postId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rejoiceCount', 'updatedAt'])
        && request.resource.data.rejoiceCount is int
        && resource.data.rejoiceCount is int
        && request.resource.data.rejoiceCount == resource.data.rejoiceCount + 1
        && request.resource.data.rejoiceCount <= 100000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isVerified() && isValidId(postId) && resource.data.authorUid == request.auth.uid;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
