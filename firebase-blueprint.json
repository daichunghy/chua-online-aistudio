{
  "entities": {
    "PilgrimProfile": {
      "title": "PilgrimProfile",
      "description": "Private pilgrimage profile and accessibility preferences for a signed-in user across all temples.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "displayName": { "type": "string", "description": "Preferred pilgrim display name." },
        "characterModelKey": { "type": "string", "description": "Selected 3D pilgrim avatar key." },
        "nationalityId": { "type": "string", "description": "Selected pilgrim nationality/origin code." },
        "elderFontScale": { "type": "number", "description": "Accessible font scale (0.95 to 1.35)." },
        "readAlongRate": { "type": "number", "description": "Preferred voice narration rate (0.7 to 1.15)." },
        "activeTempleId": { "type": "string", "description": "Currently active temple identifier (e.g. vinh_trang)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "activeTempleId", "createdAt", "updatedAt"]
    },
    "TempleProgress": {
      "title": "TempleProgress",
      "description": "Per-temple pilgrimage passport progress keyed by templeId (stamps, 18 Arhats, daily oracle, real-day lotus garden).",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "Owner Firebase Auth UID." },
        "templeId": { "type": "string", "description": "Temple slug identifier (e.g. vinh_trang, thien_mu)." },
        "visitedStations": { "type": "array", "items": { "type": "string" } },
        "heritageStamps": { "type": "array", "items": { "type": "string" } },
        "arhatStamps": { "type": "array", "items": { "type": "string" } },
        "practicedDays": { "type": "array", "items": { "type": "string" } },
        "dailyOracleDateKey": { "type": "string" },
        "dailyOracleId": { "type": "string" },
        "gardenStateJson": { "type": "string", "description": "Serialized real-day lotus garden slots and bloomed keepsakes." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "templeId", "visitedStations", "heritageStamps", "arhatStamps", "practicedDays", "createdAt", "updatedAt"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Private pilgrimage diary entry and prayer reflection linked to a specific templeId.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "Owner Firebase Auth UID." },
        "templeId": { "type": "string", "description": "Temple slug identifier." },
        "text": { "type": "string", "description": "Prayer or journal reflection text." },
        "mood": { "type": "string", "description": "Mood identifier." },
        "moodLabel": { "type": "string", "description": "Vietnamese mood label." },
        "stationLabel": { "type": "string", "description": "Station visited when writing." },
        "dateKey": { "type": "string", "description": "Calendar day key YYYY-MM-DD." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "templeId", "text", "mood", "dateKey", "createdAt"]
    },
    "CommunityLantern": {
      "title": "CommunityLantern",
      "description": "Public floating lantern wish released onto the temple lotus pond that visitors can view and bless.",
      "type": "object",
      "properties": {
        "templeId": { "type": "string", "description": "Temple slug identifier (e.g. vinh_trang)." },
        "authorUid": { "type": "string", "description": "Creator Firebase Auth UID." },
        "authorName": { "type": "string", "description": "Display name shown on the lantern." },
        "nationalityId": { "type": "string", "description": "Optional origin identifier." },
        "wishText": { "type": "string", "description": "Peaceful prayer wish displayed on the lotus pond." },
        "colorHex": { "type": "string", "description": "Warm lantern paper hex color." },
        "pondX": { "type": "number", "description": "Local X coordinate on the lotus pond." },
        "pondZ": { "type": "number", "description": "Local Z coordinate on the lotus pond." },
        "blessCount": { "type": "integer", "description": "Number of community blessings received." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["templeId", "authorUid", "authorName", "wishText", "colorHex", "pondX", "pondZ", "blessCount", "createdAt", "updatedAt"]
    },
    "BlessingTowerEntry": {
      "title": "BlessingTowerEntry",
      "description": "Public blessing lamp record displayed on the exterior Tháp Đèn Cầu An signboard.",
      "type": "object",
      "properties": {
        "templeId": { "type": "string", "description": "Temple slug identifier." },
        "authorUid": { "type": "string", "description": "Creator Firebase Auth UID." },
        "devoteeName": { "type": "string", "description": "Devotee name or Dharma name." },
        "birthYear": { "type": "string", "description": "Optional birth year (YYYY)." },
        "familyNote": { "type": "string", "description": "Optional family or location note." },
        "categoryId": { "type": "string", "description": "Blessing prayer category ID." },
        "wishText": { "type": "string", "description": "Prayer wish text." },
        "slotNumber": { "type": "integer", "description": "Lamp slot index 1..108." },
        "tier": { "type": "integer", "description": "Tower tier 1..13." },
        "dateKey": { "type": "string", "description": "Calendar day YYYY-MM-DD." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["templeId", "authorUid", "devoteeName", "categoryId", "wishText", "slotNumber", "tier", "dateKey", "createdAt"]
    },
    "PublicPilgrimProfile": {
      "title": "PublicPilgrimProfile",
      "description": "Public non-PII pilgrim profile used for friend discovery and leaderboards.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner Firebase Auth UID." },
        "displayName": { "type": "string", "description": "Public pilgrim display name." },
        "friendCode": { "type": "string", "description": "Short friend code (VT-XXXX)." },
        "charKey": { "type": "string", "description": "3D avatar model key." },
        "merit": { "type": "integer", "description": "Merit leaderboard score." },
        "streakDays": { "type": "integer", "description": "Pilgrimage practice days." },
        "giftsSent": { "type": "integer", "description": "Count of gifts sent to friends." },
        "currentArea": { "type": "string", "description": "Current temple area label." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "friendCode", "charKey", "merit", "streakDays", "giftsSent", "createdAt", "updatedAt"]
    },
    "GiftTransaction": {
      "title": "GiftTransaction",
      "description": "Record of a spiritual gift sent to another devotee.",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string", "description": "Sender Firebase Auth UID." },
        "fromName": { "type": "string", "description": "Sender display name." },
        "toId": { "type": "string", "description": "Recipient user or community member ID." },
        "toName": { "type": "string", "description": "Recipient display name." },
        "giftId": { "type": "string", "description": "Gift catalog ID." },
        "giftName": { "type": "string", "description": "Gift display label." },
        "message": { "type": "string", "description": "Blessing note sent with gift." },
        "lotusCost": { "type": "integer", "description": "Lotus merit points spent." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromUid", "fromName", "toId", "toName", "giftId", "giftName", "message", "lotusCost", "createdAt"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Public peaceful wish shared in the temple community feed.",
      "type": "object",
      "properties": {
        "templeId": { "type": "string", "description": "Temple slug identifier." },
        "authorUid": { "type": "string", "description": "Creator Firebase Auth UID." },
        "authorName": { "type": "string", "description": "Author display name." },
        "charKey": { "type": "string", "description": "Author avatar key." },
        "area": { "type": "string", "description": "Temple area label." },
        "text": { "type": "string", "description": "Peaceful wish content." },
        "rejoiceCount": { "type": "integer", "description": "Number of Tùy hỷ rejoices." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["templeId", "authorUid", "authorName", "text", "rejoiceCount", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/PilgrimProfile" },
      "description": "Private pilgrim profile document owned by uid."
    },
    "/users/{uid}/temples/{templeId}": {
      "schema": { "$ref": "#/entities/TempleProgress" },
      "description": "Private per-temple pilgrimage passport progress keyed by templeId."
    },
    "/users/{uid}/journalEntries/{entryId}": {
      "schema": { "$ref": "#/entities/JournalEntry" },
      "description": "Private pilgrimage journal and prayer records."
    },
    "/templeLanterns/{lanternId}": {
      "schema": { "$ref": "#/entities/CommunityLantern" },
      "description": "Publicly readable community floating lanterns on each temple lotus pond."
    },
    "/blessingTowerEntries/{entryId}": {
      "schema": { "$ref": "#/entities/BlessingTowerEntry" },
      "description": "Publicly readable blessing tower entries recorded at the exterior Tháp Đèn Cầu An."
    },
    "/publicProfiles/{uid}": {
      "schema": { "$ref": "#/entities/PublicPilgrimProfile" },
      "description": "Public non-PII profiles for friend lookup and temple leaderboards."
    },
    "/giftTransactions/{giftId}": {
      "schema": { "$ref": "#/entities/GiftTransaction" },
      "description": "Spiritual gift records readable by sender or recipient."
    },
    "/communityPosts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "Publicly readable peaceful community wishes with Tùy hỷ counters."
    }
  }
}
